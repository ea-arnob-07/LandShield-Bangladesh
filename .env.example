# Server-only configuration; this example contains no credentials.
# The local adapter reads shell environment values, not this file.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional legacy platform administrators: stable user IDs only.
SITE_ADMIN_USER_IDS=[]

# Optional self-hosted Photon API endpoint, HTTPS only; blank uses the public demo.
PHOTON_ENDPOINT=

# Password account secrets. Set through server runtime configuration only.
LAND_AUTH_PEPPER=
LAND_ADMIN_BOOTSTRAP=
